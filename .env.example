# Copy to .env (or export these) before running ARGUS.
# ARGUS auto-detects the provider from whichever key you set. Force it with
# ARGUS_PROVIDER = deepseek | glm | openrouter | agentrouter | openai | anthropic | custom.

# --- AgentRouter (agentrouter.org) — single key for all models ---
# One API key for DeepSeek, GLM, Claude, GPT, and more.
# Base URL: https://agentrouter.org/v1 (OpenAI-compatible)
# Get your key at agentrouter.org/console/token
#   AGENTROUTER_API_KEY=sk-...
#   ARGUS_PROVIDER=agentrouter
#   ARGUS_MODEL=z-ai/glm-5.2

# --- DeepSeek (default) ----------------------------------------------------
# DEEPSEEK_API_KEY=sk-...
# ARGUS_MODEL=deepseek-v4-pro

# --- OpenRouter (one key → many models) ------------------------------------
# Best option when you want multiple models through ONE API key. Uncomment:
#   OPENROUTER_API_KEY=sk-or-v1-...
#   ARGUS_PROVIDER=openrouter
#   ARGUS_MODEL=z-ai/glm-5.2          (GLM-5.2)
#     z-ai/glm-5.1          (GLM-5.1)
#     openai/gpt-5.6-sol-pro (GPT-5.6 Sol Pro)
#     openai/gpt-5.6-luna-pro (GPT-5.6 Luna Pro)
#     anthropic/claude-sonnet-5
#     openai/gpt-4o
# See https://openrouter.ai/models for the full catalog.

# --- GLM / Zhipu AI (direct) -----------------------------------------------
# OpenAI-compatible, pure stdlib. GLM_API_KEY = ZHIPU_API_KEY.
#   GLM_API_KEY=...
#   ARGUS_PROVIDER=glm
#   ARGUS_MODEL=glm-4

# --- OpenAI ----------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ARGUS_MODEL=gpt-4o

# --- Anthropic (pip install anthropic) -------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ARGUS_MODEL=claude-sonnet-5

# --- Local / custom endpoint -----------------------------------------------
# ARGUS_PROVIDER=custom
# ARGUS_BASE_URL=http://localhost:11434/v1
# ARGUS_MODEL=qwen2.5-coder:14b

# --- Publishing (HOST ONLY — never put these in the detonation VM) ---------
# Used by `run.py publish` to post an APPROVED finding. All optional; each
# target is skipped if its credentials are absent. Nothing posts without an
# explicit --confirm, and a VT-contradicted finding is refused unless --force.
#   VT_API_KEY=...                 # also enables `run.py enrich` (hash lookups)
# Twitter/X — OAuth 1.0a user context (developer.twitter.com):
#   TWITTER_API_KEY=...
#   TWITTER_API_SECRET=...
#   TWITTER_ACCESS_TOKEN=...
#   TWITTER_ACCESS_SECRET=...
# LinkedIn — OAuth2 bearer with w_member_social scope:
#   LINKEDIN_ACCESS_TOKEN=...
#   LINKEDIN_AUTHOR_URN=urn:li:person:xxxxxxxx

# --- Optional knobs (defaults shown) ---------------------------------------
# ARGUS_MAX_TOKENS=8000
# ARGUS_TEMPERATURE=0.2
# ARGUS_MAX_STEPS=40
# ARGUS_VAULT=C:\Second-Brain-Claude
